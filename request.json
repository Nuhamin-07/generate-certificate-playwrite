{
  "html": "<!doctype html>\r\n<html lang=\"en\">\r\n  <head>\r\n    <meta charset=\"utf-8\" />\r\n    <title>Certificate of Completion - EM360-2026-001</title>\r\n    <style>\r\n      @page {\r\n        size: 297mm 210mm;\r\n        margin: 0;\r\n      }\r\n      :root {\r\n        --deep: #0a3d47;\r\n        --teal: #0f766e;\r\n        --mint: #5eead4;\r\n        --amber: #f2a93b;\r\n        --ink: #0f172a;\r\n        --muted: #5b6776;\r\n        --line: #dfe6e8;\r\n      }\r\n      * {\r\n        box-sizing: border-box;\r\n        margin: 0;\r\n        padding: 0;\r\n      }\r\n      html,\r\n      body {\r\n        width: 297mm;\r\n        height: 210mm;\r\n        background: #fcfcfb;\r\n      }\r\n      body {\r\n        font-family: \"Poppins\", \"FreeSerif\", sans-serif;\r\n        color: var(--ink);\r\n        -webkit-print-color-adjust: exact;\r\n        print-color-adjust: exact;\r\n      }\r\n      .page {\r\n        position: relative;\r\n        width: 297mm;\r\n        height: 210mm;\r\n        overflow: hidden;\r\n        background: #fcfcfb;\r\n      }\r\n\r\n      .corner-art {\r\n        position: absolute;\r\n        right: 0;\r\n        top: 0;\r\n        width: 120mm;\r\n        height: 78mm;\r\n      }\r\n\r\n      /* ---- header: logo left, verification right ---- */\r\n      .header {\r\n        position: absolute;\r\n        left: 20mm;\r\n        right: 20mm;\r\n        top: 13mm;\r\n        display: flex;\r\n        justify-content: space-between;\r\n        align-items: flex-start;\r\n      }\r\n      .logo {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 3mm;\r\n        margin-top: 2mm;\r\n      }\r\n      .logo svg {\r\n        width: 11mm;\r\n        height: 11mm;\r\n        flex: none;\r\n      }\r\n      .logo .word {\r\n        font-weight: 600;\r\n        font-size: 15pt;\r\n        color: var(--deep);\r\n        line-height: 1;\r\n      }\r\n      .logo .word span {\r\n        font-weight: 300;\r\n        color: var(--teal);\r\n      }\r\n      .cobrand {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 3.5mm;\r\n        margin: 2mm 0 0 5mm;\r\n        padding-left: 5mm;\r\n        border-left: 0.3mm solid var(--line);\r\n        font-size: 6.4pt;\r\n        letter-spacing: 0.16em;\r\n        text-transform: uppercase;\r\n        color: var(--muted);\r\n        line-height: 1.5;\r\n      }\r\n      .cobrand b {\r\n        display: block;\r\n        font-weight: 600;\r\n        font-size: 9.5pt;\r\n        letter-spacing: 0.01em;\r\n        text-transform: none;\r\n        color: var(--deep);\r\n      }\r\n      .extra-line {\r\n        margin-top: 4.5mm;\r\n        font-size: 8pt;\r\n        color: var(--muted);\r\n        letter-spacing: 0.02em;\r\n        max-width: 220mm;\r\n      }\r\n      .extra-line b {\r\n        font-weight: 500;\r\n        color: var(--deep);\r\n      }\r\n      .verify {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 3.5mm;\r\n        text-align: right;\r\n        font-size: 6.8pt;\r\n        color: var(--muted);\r\n        line-height: 1.6;\r\n      }\r\n      .verify b {\r\n        font-weight: 600;\r\n        color: var(--deep);\r\n        letter-spacing: 0.04em;\r\n        font-size: 7.6pt;\r\n      }\r\n      .verify .qr {\r\n        width: 21mm;\r\n        height: 21mm;\r\n        background: #fff;\r\n        padding: 1.6mm;\r\n        border-radius: 2.4mm;\r\n        box-shadow: 0 0 0 0.3mm var(--line);\r\n      }\r\n      .verify .qr svg {\r\n        width: 100%;\r\n        height: 100%;\r\n        display: block;\r\n      }\r\n\r\n      /* ---- main text ---- */\r\n      .main {\r\n        position: absolute;\r\n        left: 22mm;\r\n        right: 22mm;\r\n        top: 39mm;\r\n        height: 106mm;\r\n        display: flex;\r\n        flex-direction: column;\r\n        justify-content: center;\r\n        align-items: center;\r\n        text-align: center;\r\n      }\r\n      .eyebrow {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 4mm;\r\n        font-weight: 600;\r\n        font-size: 8.2pt;\r\n        letter-spacing: 0.3em;\r\n        color: var(--teal);\r\n        text-transform: uppercase;\r\n        padding-left: 0.3em;\r\n      }\r\n      .eyebrow i {\r\n        display: block;\r\n        width: 16mm;\r\n        height: 0.3mm;\r\n        background: var(--teal);\r\n        opacity: 0.55;\r\n      }\r\n      .lead {\r\n        margin-top: 6mm;\r\n        font-weight: 400;\r\n        font-size: 10.5pt;\r\n        color: var(--muted);\r\n      }\r\n      .name {\r\n        font-family: \"Lora\", \"FreeSerif\", serif;\r\n        font-weight: 500;\r\n        color: var(--deep);\r\n        line-height: 1.12;\r\n        margin-top: 3mm;\r\n        max-width: 236mm;\r\n        text-wrap: balance;\r\n        overflow-wrap: anywhere;\r\n      }\r\n      .name.n1 {\r\n        font-size: 44pt;\r\n      }\r\n      .name.n2 {\r\n        font-size: 36pt;\r\n      }\r\n      .name.n3 {\r\n        font-size: 30pt;\r\n      }\r\n      .name.n4 {\r\n        font-size: 24pt;\r\n      }\r\n      .name.n5 {\r\n        font-size: 20pt;\r\n      }\r\n      .name-rule {\r\n        width: 22mm;\r\n        height: 0.9mm;\r\n        border-radius: 1mm;\r\n        background: var(--amber);\r\n        margin-top: 4mm;\r\n      }\r\n      .lead2 {\r\n        margin-top: 5mm;\r\n        font-weight: 400;\r\n        font-size: 10.5pt;\r\n        color: var(--muted);\r\n      }\r\n      .course {\r\n        font-weight: 500;\r\n        line-height: 1.26;\r\n        margin-top: 2mm;\r\n        max-width: 205mm;\r\n        text-wrap: balance;\r\n        overflow-wrap: anywhere;\r\n      }\r\n      .course.c1 {\r\n        font-size: 18pt;\r\n      }\r\n      .course.c2 {\r\n        font-size: 15pt;\r\n      }\r\n      .course.c3 {\r\n        font-size: 12.5pt;\r\n      }\r\n      .stats {\r\n        display: flex;\r\n        flex-wrap: wrap;\r\n        justify-content: center;\r\n        row-gap: 4mm;\r\n        margin-top: 7mm;\r\n      }\r\n      .stat {\r\n        padding: 0 7.5mm;\r\n        border-left: 0.3mm solid var(--line);\r\n        white-space: nowrap;\r\n        text-align: center;\r\n      }\r\n      .stat:first-child {\r\n        border-left: none;\r\n      }\r\n      .stat .k {\r\n        font-size: 6.3pt;\r\n        letter-spacing: 0.2em;\r\n        text-transform: uppercase;\r\n        color: var(--muted);\r\n      }\r\n      .stat .v {\r\n        margin-top: 1.2mm;\r\n        font-weight: 500;\r\n        font-size: 10.5pt;\r\n        color: var(--ink);\r\n      }\r\n\r\n      /* ---- wave footer ---- */\r\n      .wave {\r\n        position: absolute;\r\n        left: 0;\r\n        bottom: 0;\r\n        width: 297mm;\r\n        height: 64mm;\r\n      }\r\n      .sig {\r\n        position: absolute;\r\n        bottom: 11mm;\r\n        width: 58mm;\r\n        text-align: center;\r\n        color: #fff;\r\n      }\r\n      .sig.left {\r\n        left: 30mm;\r\n      }\r\n      .sig.right {\r\n        right: 30mm;\r\n      }\r\n      .sig .scribble {\r\n        font-family: \"Lora\", \"FreeSerif\", serif;\r\n        font-style: italic;\r\n        font-size: 16pt;\r\n        height: 8.5mm;\r\n        line-height: 8.5mm;\r\n      }\r\n      .sig .line {\r\n        height: 0.3mm;\r\n        background: rgba(255, 255, 255, 0.6);\r\n      }\r\n      .sig .who {\r\n        margin-top: 1.6mm;\r\n        font-weight: 500;\r\n        font-size: 8.4pt;\r\n      }\r\n      .sig .role {\r\n        font-weight: 300;\r\n        font-size: 7.4pt;\r\n        color: #b9ece6;\r\n        margin-top: 0.3mm;\r\n      }\r\n      .seal {\r\n        position: absolute;\r\n        left: 133.5mm;\r\n        top: 141mm;\r\n        width: 30mm;\r\n        height: 39mm;\r\n        filter: drop-shadow(0 1.2mm 1.8mm rgba(5, 30, 36, 0.35));\r\n      }\r\n      .sample-note {\r\n        position: absolute;\r\n        left: 0;\r\n        right: 0;\r\n        bottom: 3.6mm;\r\n        text-align: center;\r\n        font-size: 6.3pt;\r\n        letter-spacing: 0.1em;\r\n        color: rgba(255, 255, 255, 0.55);\r\n      }\r\n    </style>\r\n  </head>\r\n  <body>\r\n    <div class=\"page\">\r\n      <svg\r\n        class=\"corner-art\"\r\n        viewBox=\"0 0 120 78\"\r\n        xmlns=\"http://www.w3.org/2000/svg\"\r\n      >\r\n        <g\r\n          fill=\"none\"\r\n          stroke=\"#0f766e\"\r\n          stroke-opacity=\"0.11\"\r\n          stroke-width=\"0.35\"\r\n        >\r\n          <circle cx=\"122\" cy=\"-4\" r=\"22\" />\r\n          <circle cx=\"122\" cy=\"-4\" r=\"36\" />\r\n          <circle cx=\"122\" cy=\"-4\" r=\"50\" />\r\n          <circle cx=\"122\" cy=\"-4\" r=\"64\" />\r\n          <circle cx=\"122\" cy=\"-4\" r=\"78\" />\r\n        </g>\r\n        <circle cx=\"96\" cy=\"46\" r=\"1.1\" fill=\"#f2a93b\" fill-opacity=\"0.9\" />\r\n        <circle cx=\"62\" cy=\"12\" r=\"0.8\" fill=\"#0f766e\" fill-opacity=\"0.5\" />\r\n      </svg>\r\n\r\n      <div class=\"header\">\r\n        <div style=\"display: flex; align-items: flex-start\">\r\n          <div class=\"logo\">\r\n            <svg viewBox=\"0 0 44 44\" xmlns=\"http://www.w3.org/2000/svg\">\r\n              <circle\r\n                cx=\"22\"\r\n                cy=\"22\"\r\n                r=\"16\"\r\n                fill=\"none\"\r\n                stroke=\"#0a3d47\"\r\n                stroke-width=\"3\"\r\n              />\r\n              <path\r\n                d=\"M22 6 A16 16 0 0 1 38 22\"\r\n                fill=\"none\"\r\n                stroke=\"#f2a93b\"\r\n                stroke-width=\"3.8\"\r\n                stroke-linecap=\"round\"\r\n              />\r\n              <circle cx=\"22\" cy=\"22\" r=\"5\" fill=\"#0f766e\" />\r\n            </svg>\r\n            <div class=\"word\">EduMarket<span>360</span></div>\r\n          </div>\r\n          \r\n        </div>\r\n        <div class=\"verify\">\r\n          <div>\r\n            Certificate ID<br /><b>EM360-2026-001</b><br />Verify at\r\n            edumarket360.com\r\n          </div>\r\n          <div class=\"qr\"></div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"main\">\r\n        <div class=\"eyebrow\"><i></i>CERTIFICATE OF COMPLETION<i></i></div>\r\n        <div class=\"lead\">This certificate is proudly presented to</div>\r\n        <div class=\"name n1\">Nuhamin Gulilat</div>\r\n        <div class=\"name-rule\"></div>\r\n        <div class=\"lead2\">for successfully completing</div>\r\n        <div class=\"course c1\">Web Development</div>\r\n        <div class=\"stats\">\n    <div class=\"stat\">\n      <div class=\"k\">COMPLETION DATE</div>\n      <div class=\"v\">October 19, 2026</div>\n    </div>\n  </div>\r\n        \r\n      </div>\r\n\r\n      <svg\r\n        class=\"wave\"\r\n        viewBox=\"0 0 297 64\"\r\n        preserveAspectRatio=\"none\"\r\n        xmlns=\"http://www.w3.org/2000/svg\"\r\n      >\r\n        <defs>\r\n          <linearGradient id=\"w3\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\r\n            <stop offset=\"0\" stop-color=\"#0a3d47\" />\r\n            <stop offset=\"0.6\" stop-color=\"#0d5a60\" />\r\n            <stop offset=\"1\" stop-color=\"#0f766e\" />\r\n          </linearGradient>\r\n        </defs>\r\n        <path\r\n          d=\"M0 8 C60 -4 120 20 190 8 S270 -2 297 6 V64 H0Z\"\r\n          fill=\"#5eead4\"\r\n          fill-opacity=\"0.35\"\r\n        />\r\n        <path\r\n          d=\"M0 16 C70 4 130 28 200 16 S275 8 297 14 V64 H0Z\"\r\n          fill=\"#14b8a6\"\r\n          fill-opacity=\"0.55\"\r\n        />\r\n        <path\r\n          d=\"M0 24 C80 12 140 34 210 22 S280 16 297 22 V64 H0Z\"\r\n          fill=\"url(#w3)\"\r\n        />\r\n      </svg>\r\n\r\n      <div class=\"sig left\">\r\n        <div class=\"scribble\">EduMarket360</div>\r\n        <div class=\"line\"></div>\r\n        <div class=\"who\">Course Director</div>\r\n        <div class=\"role\">EduMarket360</div>\r\n      </div>\r\n      <div class=\"sig right\">\r\n        <div class=\"scribble\">Authorized</div>\r\n        <div class=\"line\"></div>\r\n        <div class=\"who\">Training Manager</div>\r\n        <div class=\"role\">EduMarket360</div>\r\n      </div>\r\n\r\n      <svg\r\n        class=\"seal\"\r\n        viewBox=\"0 0 100 130\"\r\n        xmlns=\"http://www.w3.org/2000/svg\"\r\n      >\r\n        <defs>\r\n          <linearGradient id=\"sg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\r\n            <stop offset=\"0\" stop-color=\"#ffd27a\" />\r\n            <stop offset=\"0.55\" stop-color=\"#f2a93b\" />\r\n            <stop offset=\"1\" stop-color=\"#d98618\" />\r\n          </linearGradient>\r\n        </defs>\r\n        <polygon points=\"27,70 50,70 50,124 38.5,112 27,124\" fill=\"#d98618\" />\r\n        <polygon points=\"50,70 73,70 73,124 61.5,112 50,124\" fill=\"#f2a93b\" />\r\n        <circle cx=\"50\" cy=\"44\" r=\"40\" fill=\"url(#sg)\" />\r\n        <circle\r\n          cx=\"50\"\r\n          cy=\"44\"\r\n          r=\"33\"\r\n          fill=\"none\"\r\n          stroke=\"#fffaf0\"\r\n          stroke-width=\"1.6\"\r\n        />\r\n        <circle\r\n          cx=\"50\"\r\n          cy=\"44\"\r\n          r=\"29.5\"\r\n          fill=\"none\"\r\n          stroke=\"#fffaf0\"\r\n          stroke-opacity=\"0.55\"\r\n          stroke-width=\"0.6\"\r\n        />\r\n        <path\r\n          d=\"M34 45 L45 56 L67 31\"\r\n          fill=\"none\"\r\n          stroke=\"#fffaf0\"\r\n          stroke-width=\"6.5\"\r\n          stroke-linecap=\"round\"\r\n          stroke-linejoin=\"round\"\r\n        />\r\n      </svg>\r\n\r\n      <div class=\"sample-note\">SAMPLE CERTIFICATE</div>\r\n    </div>\r\n  </body>\r\n</html>\r\n"
